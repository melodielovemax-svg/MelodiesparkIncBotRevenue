{
  "name": "{{PACKAGE_NAME}}",
  "version": "{{PACKAGE_VERSION}}",
  "description": "{{DESCRIPTION}}",
  "license": "{{LICENSE}}",
  "author": "{{AUTHOR}}",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "{{CLI_BIN}}": "./bin/{{CLI_BIN}}.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck && node --check bin/{{CLI_BIN}}.mjs",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "selftest": "node bin/{{CLI_BIN}}.mjs selftest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "cli",
    "tool",
    "scaffold",
    "zero-dependency"
  ],
  "publishConfig": {
    "access": "public"
  }
}
