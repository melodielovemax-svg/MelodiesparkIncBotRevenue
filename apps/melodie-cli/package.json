{
  "name": "melodie-cli-v9.34.32999",
  "version": "9.34.32999",
  "description": "Melodie-CLI V9.34.32999 - Unified MelodieMetamelo-DS Ultimate CLI. Cross-platform coding-agent platform, Web3 wallet integration, IDE orchestration, and content catalog with governed execution, model gateway, sandbox, and evidence engine.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "melodie": "./bin/melodie.mjs",
    "melodie-v9": "./bin/melodie.mjs",
    "melodie-cli": "./bin/melodie.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": "./src/contracts.ts",
    "./web3": "./src/commands/web3.ts",
    "./ide": "./src/commands/ide.ts"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "assets",
    "models",
    "agents",
    "tasks",
    "docs",
    "README.md",
    "BUILD_MANIFEST.json"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run build && node scripts/stamp-manifest.mjs",
    "catalog": "node bin/melodie.mjs catalog --build",
    "verify": "node bin/melodie.mjs verify",
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "melodiespark",
    "cli",
    "catalog",
    "scaffolding",
    "web3",
    "template"
