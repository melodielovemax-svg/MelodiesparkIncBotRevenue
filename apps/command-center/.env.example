# Melodiespark Command Center - safe template
# Copy to .env through: .\Start-Melodiespark.ps1 -Initialize
# Never commit real API keys, passwords, bank details, or wallet private keys.

NODE_ENV=development
HOST=127.0.0.1
PORT=4173
APP_MODE=demo
REQUIRE_AUTH=false
TRUST_PROXY=false

# Generate with: .\Start-Melodiespark.ps1 -SetPassword
ADMIN_EMAIL=admin@example.invalid
# ADMIN_PASSWORD_HASH is intentionally omitted.
SESSION_SECRET=
PORTAL_SECRET=

# Optional read-only Shopify custom-app token. Use a read-scoped token where possible.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=

# Optional Stripe restricted/live key. Prefer a restricted key and rotate regularly.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal requires an OAuth application and approved integration. Secrets are intentionally unsupported in v0.1.
PAYPAL_CLIENT_ID=
PAYPAL_ENVIRONMENT=sandbox

# Optional Ethereum RPC used only for read-only native ETH balances.
ETHEREUM_RPC_URL=
ETH_CHAIN_ID=1

# Safe scheduler: minimum 300 seconds. It never places trades or transfers funds.
ENABLE_SAFE_SCHEDULER=false
SAFE_CYCLE_INTERVAL_SECONDS=300
ALLOW_REMOTE_WEBHOOKS=false
PUBLIC_BASE_URL=http://localhost:4173
EXECUTION_TIMEOUT_MS=30000
LOG_LEVEL=info
ENABLE_EXECUTION_METRICS=true
