[application]
config/name="Path of Melodie"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.018, 0.025, 0.05, 1)

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
dodge={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
phoenix={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
skill_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
skill_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
skill_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
skill_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}

[gui]
theme/default_font_multichannel_signed_distance_field=true
