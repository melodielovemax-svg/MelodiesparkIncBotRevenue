name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  ci:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22.x'

      # The package has no runtime dependencies. devDependencies (the TypeScript
      # compiler and Node type definitions) are what build and test need, so
      # `npm ci` is deliberately not used: a fresh scaffold has no lockfile and
      # `npm ci` would fail on it.
      - name: Install
        run: npm install --no-audit --no-fund

      - name: Lint
        run: npm run lint

      - name: Test
        run: npm test

      # Exercises the published bin/ entry point with no build artifacts loaded.
      - name: CLI selftest
        run: npm run selftest
